---
// Guía de llegada de Aromatik House — mismo contenido en los 9 idiomas.
import { llegadaHouseContent, routeLinks } from '../i18n/llegadaHouse';

interface Props { lang: string }
const { lang } = Astro.props;
const c = llegadaHouseContent[lang] ?? llegadaHouseContent.es;
const img = '/images/aromatik-house/llegada';
---
<div class="llegada">
  <img class="llegada-hero" src={`${img}/aerea-casa.jpg`} alt={c.altHero} width="1200" height="900" />

  <div class="llegada-body">
    <header class="llegada-head">
      <span class="llegada-eyebrow">{c.eyebrow}</span>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
    </header>

    <div class="llegada-facts">
      <div><span>{c.checkIn}</span><strong>15:00</strong></div>
      <div><span>{c.checkOut}</span><strong>11:00</strong></div>
      <div><span>{c.keys}</span><strong>{c.keysValue}</strong></div>
    </div>

    <figure class="llegada-map">
      <svg viewBox="0 0 358 400" role="img" aria-label={c.mapAria}>
        <rect width="358" height="400" fill="#F1ECE2" />
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M70 40 C140 52 230 92 301 110" stroke="#FFFFFF" stroke-width="9" />
          <path d="M70 40 C140 52 230 92 301 110" stroke="#2C5F2E" stroke-width="4" />
          <path d="M301 110 C310 170 330 260 325 321" stroke="#C9B48A" stroke-width="9" />
          <path d="M301 110 C310 170 330 260 325 321" stroke="#2C5F2E" stroke-width="4" stroke-dasharray="9 7" />
          <path d="M325 321 C310 335 292 348 279 360" stroke="#2C5F2E" stroke-width="4" stroke-dasharray="3 6" />
        </g>
        <circle cx="70" cy="40" r="14" fill="#2C5F2E" />
        <text x="70" y="45" text-anchor="middle" font-size="14" font-weight="500" fill="#FFFFFF">P</text>
        <circle cx="301" cy="110" r="10" fill="#FFFFFF" stroke="#2C5F2E" stroke-width="3" />
        <circle cx="325" cy="321" r="8" fill="#FFFFFF" stroke="#2C5F2E" stroke-width="3" />
        <g transform="translate(267 360)" fill="#2C5F2E">
          <path d="M12 0 L24 10 L21 10 L21 24 L3 24 L3 10 L0 10 Z" />
          <rect x="9.5" y="15" width="5" height="9" fill="#FFFFFF" />
        </g>
        <g font-size="13" fill="#3A3530">
          <text x="56" y="106" font-weight="500">{c.mapParking}</text>
          <text x="56" y="123" fill="#6B6560">{c.mapStart}</text>
          <text x="168" y="54" text-anchor="middle" fill="#224A23" font-weight="500" transform="rotate(14 168 54)">{c.mapKm}</text>
          <text x="286" y="136" text-anchor="end" font-weight="500">{c.mapTurn}</text>
          <text x="300" y="220" text-anchor="end" fill="#224A23" font-weight="500">{c.mapDirt}</text>
          <text x="311" y="318" text-anchor="end" font-weight="500">{c.mapEntrance}</text>
          <text x="311" y="335" text-anchor="end" fill="#6B6560">{c.mapOnLeft}</text>
          <text x="257" y="378" text-anchor="end" font-weight="500">Aromatik House</text>
        </g>
      </svg>
      <figcaption>{c.mapCaption}</figcaption>
    </figure>

    <section>
      <h2>{c.stepsTitle}</h2>
      <ol class="llegada-steps">
        <li>
          <h3>{c.s1Title}</h3>
          <p>{c.s1Text}</p>
          <a class="btn-route" href={routeLinks.google} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8-8-2z" /></svg>
            {c.s1Btn}
          </a>
          <p class="llegada-note">{c.s1Alt}</p>
          <div class="llegada-apps">
            <a class="btn-app" href={routeLinks.apple} target="_blank" rel="noopener">Apple Maps</a>
            <a class="btn-app" href={routeLinks.waze} target="_blank" rel="noopener">Waze</a>
          </div>
        </li>
        <li>
          <h3>{c.s2Title}</h3>
          <p>{c.s2Text}</p>
        </li>
        <li>
          <h3>{c.s3Title}</h3>
          <p>{c.s3Text}</p>
          <!-- PENDIENTE: foto de la entrada del camino de tierra (la enviará Arnau) -->
          <a class="btn-app" href={routeLinks.streetView} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /></svg>
            {c.s3Btn}
          </a>
        </li>
        <li>
          <h3>{c.s4Title}</h3>
          <p>{c.s4Text}</p>
          <img src={`${img}/entrada-camino.jpg`} alt={c.altEntrance} loading="lazy" width="1200" height="800" />
        </li>
        <li>
          <h3>{c.s5Title}</h3>
          <p>{c.s5Text}</p>
          <img src={`${img}/aerea-finca.jpg`} alt={c.altHouse} loading="lazy" width="1200" height="900" />
        </li>
        <li>
          <h3>{c.s6Title}</h3>
          <p>{c.s6Text}</p>
          <!-- PENDIENTE: foto y ubicación de la caja de llaves (las enviará Arnau). El código NO va aquí: va en el mensaje de Smoobu. -->
        </li>
      </ol>
    </section>

    <section class="llegada-help">
      <h2>{c.helpTitle}</h2>
      <p>{c.helpText}</p>
      <div class="llegada-apps">
        <a class="btn-route" href="https://wa.me/34682636848" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z" /></svg>
          WhatsApp
        </a>
        <a class="btn-app" href="tel:+34930308209">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
          {c.call}
        </a>
      </div>
    </section>
  </div>
</div>

<style>
.llegada { margin-top: 70px; background: var(--cream); }
.llegada-hero { display: block; width: 100%; height: clamp(240px, 45vw, 420px); object-fit: cover; }
.llegada-body { max-width: 560px; margin: 0 auto; padding: 1.75rem 1rem 3rem; display: flex; flex-direction: column; gap: 1.75rem; }
.llegada-head { display: flex; flex-direction: column; gap: 0.6rem; }
.llegada-eyebrow { font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--stone-600); font-weight: 500; }
.llegada h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.9rem, 6vw, 2.4rem); line-height: 1.2; }
.llegada h2 { font-family: var(--serif); font-weight: 400; font-size: 1.4rem; margin-bottom: 1.1rem; }
.llegada h3 { font-size: 1rem; font-weight: 500; }
.llegada p { font-size: 0.95rem; line-height: 1.55; color: var(--stone-800); }
.llegada-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
.llegada-facts div { background: var(--white); border: 1px solid var(--stone-200); border-radius: 8px; padding: 0.75rem 0.65rem; display: flex; flex-direction: column; gap: 0.1rem; }
.llegada-facts span { font-size: 0.7rem; color: var(--stone-600); text-transform: uppercase; letter-spacing: 0.08em; }
.llegada-facts strong { font-size: 1.05rem; font-weight: 500; }
.llegada-map { margin: 0; background: var(--white); border: 1px solid var(--stone-200); border-radius: var(--radius-lg); overflow: hidden; }
.llegada-map svg { display: block; width: 100%; height: auto; font-family: var(--sans); }
.llegada-map figcaption { padding: 0.75rem 1rem; border-top: 1px solid var(--stone-200); font-size: 0.8rem; color: var(--stone-600); }
.llegada-steps { list-style: none; padding: 0; margin: 0; counter-reset: paso; }
.llegada-steps li { counter-increment: paso; position: relative; padding: 0.25rem 0 1.75rem 2.9rem; display: flex; flex-direction: column; gap: 0.65rem; }
.llegada-steps li::before { content: counter(paso); position: absolute; left: 0; top: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--green); color: var(--white); font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; justify-content: center; }
.llegada-steps li:not(:last-child)::after { content: ""; position: absolute; left: 14px; top: 34px; bottom: 4px; width: 2px; background: var(--stone-200); }
.llegada-steps img { width: 100%; height: 190px; object-fit: cover; border-radius: 10px; display: block; }
.llegada-note { font-size: 0.82rem !important; color: var(--stone-600) !important; }
.llegada-apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
.btn-route, .btn-app { display: flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 48px; padding: 0 0.75rem; border-radius: 6px; font-size: 0.92rem; font-weight: 500; text-align: center; }
.btn-route { background: var(--green); color: var(--white); }
.btn-route:hover { background: var(--green-hover); }
.btn-app { background: var(--white); border: 1px solid var(--stone-200); color: var(--black); font-weight: 400; }
.btn-app:hover { border-color: var(--stone-400); }
.llegada-help { background: var(--stone-50); border-radius: var(--radius-lg); padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
.llegada-help h2 { margin-bottom: 0; }
</style>
