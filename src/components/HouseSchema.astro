---
// JSON-LD de Aromatik House. Solo la localidad: la ubicación exacta no se publica.
import { houseContent, HOUSE } from '../i18n/house';

interface Props { lang: string }
const { lang } = Astro.props;
const c = houseContent[lang] ?? houseContent.es;
const siteUrl = 'https://aromatik.apartments';
const langRoot = lang === 'es' ? '' : '/' + lang;
const url = siteUrl + langRoot + '/house';

const houseSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  'name': 'Aromatik House',
  'description': c.metaDescription,
  'url': url,
  'telephone': '+34 930 30 82 09',
  'email': 'hola@aromatik.apartments',
  'address': { '@type': 'PostalAddress', 'addressLocality': 'Peratallada', 'addressRegion': 'Girona', 'postalCode': '17113', 'addressCountry': 'ES' },
  'numberOfRooms': 2,
  'petsAllowed': true,
  'smokingAllowed': false,
  'checkinTime': '15:00',
  'checkoutTime': '11:00',
  'amenityFeature': ['Private pool', 'Garden', 'Barbecue', 'Fireplace', 'Air conditioning', 'WiFi', 'Free parking', 'Self check-in']
    .map((name) => ({ '@type': 'LocationFeatureSpecification', 'name': name, 'value': true })),
  'image': [1, 2, 3].map((n) => `${siteUrl}/images/aromatik-house/dron/dron-${n}.jpg`)
    .concat([1, 2, 16].map((n) => `${siteUrl}/images/aromatik-house/fotos/foto-${n}.jpg`)),
  'parentOrganization': { '@type': 'Organization', 'name': 'Aromatik Apartments', 'url': siteUrl },
  'identifier': HOUSE.registration,
});

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Aromatik', 'item': siteUrl },
    { '@type': 'ListItem', 'position': 2, 'name': 'Aromatik House', 'item': url },
  ],
});
---
<script is:inline type="application/ld+json" set:html={houseSchema} />
<script is:inline type="application/ld+json" set:html={breadcrumbSchema} />
