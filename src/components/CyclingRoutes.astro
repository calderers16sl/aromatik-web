---
// Rutas en bici desde Girona para /ciclistas. Solo en los idiomas de las guías.
import { guides, isGuideLocale } from '../i18n/guides';

interface Props { lang: string }
const { lang } = Astro.props;
const c = isGuideLocale(lang) ? guides[lang].cycling : null;
---
{c && (
  <section class="section cr">
    <div class="container cr-wrap">
      <h2>{c.h2}</h2>
      <p class="cr-intro">{c.intro}</p>
      <ol class="cr-list">
        {c.routes.map((r) => (
          <li>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
      <p class="cr-note">{c.note}</p>
    </div>
  </section>
)}

<style>
.cr-wrap { max-width: 900px; }
.cr h2 { font-family: var(--serif); font-size: clamp(2rem, 3.6vw, 3rem); font-weight: 400; line-height: 1.2; margin: 0 0 1rem; text-align: center; }
.cr-intro { color: var(--stone-600); line-height: 1.8; margin: 0 auto 2.5rem; max-width: 680px; text-align: center; }
.cr-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.cr-list li { background: var(--white); border: 1px solid var(--stone-200); border-radius: var(--radius-lg); padding: 1.5rem; }
.cr-list h3 { font-family: var(--serif); font-size: 1.1rem; font-weight: 400; margin-bottom: 0.4rem; }
.cr-list p { font-size: 0.9rem; color: var(--stone-600); line-height: 1.7; }
.cr-note { margin-top: 1.5rem; font-size: 0.85rem; color: var(--stone-600); text-align: center; }
@media (max-width: 700px) { .cr-list { grid-template-columns: minmax(0, 1fr); } }
</style>
