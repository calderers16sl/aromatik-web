---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getT } from '../i18n/translations';
const t = getT('es');
---
<BaseLayout title={`${t.bookConfirmedTitle} — Aromatik Apartments`} description={t.bookConfirmedSubtitle} lang="es">
  <section class="confirmed-hero">
    <div class="confirmed-icon">✓</div>
    <span class="eyebrow">{t.bookConfirmedEyebrow}</span>
    <h1>{t.bookConfirmedTitle}</h1>
    <p>{t.bookConfirmedSubtitle}</p>
  </section>

  <section class="section confirmed-steps">
    <div class="container">
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>{t.bookConfirmedStep1Title}</h3>
          <p>{t.bookConfirmedStep1Text}</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>{t.bookConfirmedStep2Title}</h3>
          <p>{t.bookConfirmedStep2Text}</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>{t.bookConfirmedStep3Title}</h3>
          <p>{t.bookConfirmedStep3Text}</p>
        </div>
      </div>
      <div class="confirmed-ctas">
        <a href="/" class="btn btn-green">{t.bookConfirmedCta}</a>
        <a href="/house-rules" class="btn btn-outline">{t.bookConfirmedRules}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
.confirmed-hero {
  text-align: center;
  padding: 5rem 1.5rem 3rem;
  background: var(--cream);
  margin-top: 70px;
}
.confirmed-icon {
  width: 72px; height: 72px;
  background: var(--gold);
  color: #fff;
  border-radius: 50%;
  font-size: 2rem;
  line-height: 72px;
  margin: 0 auto 1.5rem;
}
.confirmed-hero h1 {
  font-family: var(--serif);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 400;
  margin: 0.5rem 0 1rem;
}
.confirmed-hero p {
  color: var(--stone-500);
  max-width: 560px;
  margin: 0 auto;
  font-size: 1.1rem;
  line-height: 1.7;
}
.steps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}
.step-card {
  background: #fff;
  border: 1px solid var(--stone-200, #e5e0d8);
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
}
.step-num {
  width: 44px; height: 44px;
  background: var(--cream);
  border: 2px solid var(--gold);
  color: var(--gold);
  border-radius: 50%;
  font-family: var(--serif);
  font-size: 1.25rem;
  line-height: 40px;
  margin: 0 auto 1rem;
}
.step-card h3 {
  font-family: var(--serif);
  font-size: 1.15rem;
  font-weight: 500;
  margin: 0 0 0.5rem;
}
.step-card p {
  color: var(--stone-500);
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 0;
}
.confirmed-ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.btn-outline {
  display: inline-block;
  padding: 0.75rem 2rem;
  border: 2px solid var(--stone-400, #a09890);
  color: var(--stone-700, #5c5248);
  border-radius: 6px;
  font-size: 0.95rem;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}
.btn-outline:hover { border-color: var(--gold); color: var(--gold); }
</style>
