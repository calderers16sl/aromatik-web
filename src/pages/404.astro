---
/**
 * 404 page. Astro emits this as dist/404.html, which Cloudflare Pages serves
 * with a real 404 status for any unmatched route. Without it, Pages falls
 * back to serving the root index.html with a 200 for every unknown URL
 * (soft-404), which is how /en/es ended up "existing" in Google's index.
 * One page for all languages (Pages serves a single 404.html), so the copy
 * is Spanish + English with links to every language home.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Página no encontrada — Aromatik Apartments"
  description="La página que buscas no existe. Vuelve a la web oficial de Aromatik Apartments, apartamentos turísticos en el Barri Vell de Girona."
  lang="es"
>
  <section class="nf-hero">
    <span class="nf-code">404</span>
    <h1>Página no encontrada</h1>
    <p>La página que buscas no existe o ha cambiado de dirección.</p>
    <p class="nf-en">Page not found — the page you're looking for doesn't exist or has moved.</p>
    <div class="nf-ctas">
      <a href="/" class="btn btn-green">Ir a la portada</a>
      <a href="/reservar#motor" class="btn btn-outline">Reservar</a>
    </div>
    <p class="nf-langs">
      <a href="/">ES</a> · <a href="/en/">EN</a> · <a href="/fr/">FR</a> · <a href="/ca/">CA</a> ·
      <a href="/de/">DE</a> · <a href="/zh/">中文</a> · <a href="/ko/">한국어</a> · <a href="/pt/">PT</a> · <a href="/nl/">NL</a>
    </p>
  </section>
</BaseLayout>

<style is:global>
.nf-hero {
  text-align: center;
  padding: 6rem 1.5rem 5rem;
  background: var(--cream);
  margin-top: 70px;
  min-height: 60vh;
}
.nf-code {
  display: inline-block;
  font-family: var(--serif);
  font-size: clamp(3rem, 10vw, 5rem);
  line-height: 1;
  color: var(--gold);
  margin-bottom: 1rem;
}
.nf-hero h1 {
  font-family: var(--serif);
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 400;
  margin: 0.25rem 0 1rem;
}
.nf-hero p {
  color: var(--stone-500);
  max-width: 560px;
  margin: 0 auto;
  font-size: 1.05rem;
  line-height: 1.7;
}
.nf-hero .nf-en {
  font-size: 0.95rem;
  margin-top: 0.5rem;
  opacity: 0.85;
}
.nf-ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  margin: 2.25rem 0 2rem;
}
.nf-langs {
  font-family: var(--sans);
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.nf-langs a { color: var(--stone-500); text-decoration: none; }
.nf-langs a:hover { color: var(--gold); }
</style>
