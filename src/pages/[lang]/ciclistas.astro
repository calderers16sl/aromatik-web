---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/audience.css';
import GuestRatings from '../../components/GuestRatings.astro';
import CyclingRoutes from '../../components/CyclingRoutes.astro';
import CyclistFaq from '../../components/CyclistFaq.astro';
import { NON_DEFAULT_LOCALES, getT, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map(lang => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Locale };
const langRoot = `/${lang}`;
const t = getT(lang);

