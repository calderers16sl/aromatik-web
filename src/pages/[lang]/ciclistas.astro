const c = copy[lang] ?? copy['en'];

const featuredApts = [
  { slug: "bergamota",  guests: 6, bedrooms: 3, tag: c.tag1, desc: c.tagline1, photo: "/images/apartamentos/bergamota/foto-1.jpg",  name: "Bergamota" },
  { slug: "arbol-de-te",guests: 6, bedrooms: 3, tag: c.tag2, desc: c.tagline2, photo: "/images/apartamentos/arbol-de-te/foto-1.jpg",name: "Árbol de té" },
  { slug: "romani",     guests: 2, bedrooms: 1, tag: c.tag3, desc: c.tagline3, photo: "/images/apartamentos/romani/foto-1.jpg",     name: "Romaní" },
];
---
<BaseLayout title={c.metaTitle} description={c.metaDesc} lang={lang}>

  <section class="audience-hero audience-hero--ciclistas">
    <div class="audience-hero-overlay"></div>
    <div class="audience-hero-inner">
      <h1 set:html={c.h1.replace('\n',' <br/>')} />
      <p>{c.subtitle}</p>
      <div class="audience-hero-actions">
        <a href={`${langRoot}/reservar#motor`} class="btn btn-green">{t.navBook}</a>
        <a href="#apartamentos-ciclistas" class="btn btn-outline-white">{t.heroCta1}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>{c.perksTitle}</h2>
      </div>
      <div class="audience-perks">
        {c.perks.map((p: any) => (
          <div class="audience-perk">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-sm">
      <h2 class="audience-h2">{c.blockTitle}</h2>
      <div class="prose">
        <p>{c.blockText1}</p>
        <p>{c.blockText2}</p>
        <p>{c.blockText3}</p>
      </div>
    </div>
  </section>

  <CyclingRoutes lang={lang} />

  <CyclistFaq lang={lang} />

  <section id="apartamentos-ciclistas" class="section">
    <div class="container">
      <div class="section-header">
        <h2>{c.aptsTitle}</h2>
        <p>{c.aptsSub}</p>
      </div>
      <div class="audience-apts">
        {featuredApts.map(apt => (
          <a href={`${langRoot}/apartamentos/${apt.slug}`} class="audience-apt-card">
            <div class="audience-apt-img" style={`background-image:url('${apt.photo}')`}>
              <span class="audience-apt-tag">{apt.tag}</span>
            </div>
            <div class="audience-apt-body">
              <h3>{apt.name}</h3>
              <p class="audience-apt-meta">{t.aptsGuests(apt.guests)}, {t.aptsBedroom(apt.bedrooms)}</p>
              <p class="audience-apt-desc">{apt.desc}</p>
              <span class="audience-apt-link">{c.viewApt}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="audience-more">
        <a href={`${langRoot}/#apartamentos`} class="btn btn-border">{c.allApts}</a>
      </div>
    </div>
  </section>

  <GuestRatings lang={lang} />

  <section class="section">
    <div class="container audience-cta">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaSub}</p>
      <div class="audience-cta-actions">
        <a href={`${langRoot}/reservar#motor`} class="btn btn-green">{c.ctaBtn}</a>
        <a href={`${langRoot}/contacto`} class="btn btn-border">{c.ctaBtn2}</a>
      </div>
    </div>
  </section>

</BaseLayout>
<style>
.audience-hero--ciclistas { background-image: url('/images/apartamentos/arbol-de-te/foto-1.jpg'); }
</style>
