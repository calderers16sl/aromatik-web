---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuestRatings from '../components/GuestRatings.astro';
---
<BaseLayout
  title="Sobre Aromatik Apartments — Apartamentos boutique en el Barri Vell de Girona"
  description="Aromatik Apartments es una pequeña colección de apartamentos boutique en el Barri Vell de Girona, gestionados personalmente por Arnau. Reserva directamente al mejor precio disponible."
>
  <div class="inner-hero">
    <h1>Sobre Aromatik Apartments</h1>
  </div>

  <section class="section">
    <div class="container">
      <div class="about-grid about-grid--single">
        <div class="prose">
          <p>
            Aromatik Apartments es una pequeña colección de apartamentos boutique en el corazón del Barri Vell de Girona,
            gestionados personalmente por Arnau.
          </p>
          <p>
            Nuestro objetivo es sencillo: ofrecer apartamentos cómodos, bien ubicados, con comunicación clara, acceso
            fácil mediante código y el mismo servicio de confianza que encontrarías al reservar a través de Airbnb.
          </p>
          <p>
            Al reservar directamente en nuestra web obtienes el <strong>mejor precio disponible</strong>, sin comisiones de plataforma y con la misma calidad y atención personalizada que encontrarías en Airbnb.
          </p>
          <p>
            Alójate en el centro histórico de Girona, reserva directamente y disfruta de una forma más personal de viajar.
          </p>

        </div>
      </div>
    </div>
  </section>

  <GuestRatings />

  <section class="section">
    <div class="container cta-band">
      <h2>Ocho apartamentos en el Barri Vell de Girona</h2>
      <p>Todos gestionados personalmente. Todos con reserva directa disponible.</p>
      <div class="cta-band-actions">
        <a href="/#apartamentos" class="btn btn-dark">Ver todos los apartamentos</a>
        <a href="/contacto" class="btn btn-border">Escribirme directamente</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid--single { grid-template-columns: minmax(0, 1fr) !important; max-width: 680px; margin: 0 auto; }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }
  .prose p { margin-bottom: 1.25rem; line-height: 1.8; color: var(--stone-800); }
  @media (max-width: 768px) {
    .about-grid--single { grid-template-columns: minmax(0, 1fr) !important; max-width: 680px; margin: 0 auto; }
  .about-grid { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .about-sidebar { order: -1; }
  }
</style>
